# =========================================
# Tony Shopping — local environment template
# Copy to `.env.local` and fill in values.
# Never commit `.env.local`.
# =========================================

# Public site URL (used in metadata, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Force mock data for every adapter regardless of credentials.
# Useful for offline demos. Default = false.
# MOCK_MODE=true


# -----------------------------------------------------------------------------
# Real shopping search APIs.
# Without these, the corresponding adapter falls back to mock data automatically.
# -----------------------------------------------------------------------------

# Naver Shopping Search API — https://developers.naver.com
#   1) Log in with a Naver account
#   2) Application -> "애플리케이션 등록" -> Use "검색" API
#   3) Web service URL: http://localhost:3000 (and your prod domain)
#   Free tier: 25,000 calls/day
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# eBay Browse API — https://developer.ebay.com
#   1) Create a free developer account
#   2) Application Keys -> Production keyset
#   3) Use the Client ID + Client Secret (OAuth client_credentials)
#   Free tier: 5,000 calls/day
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# SerpAPI Google Shopping — https://serpapi.com
#   1) Sign up (free 100 searches/month)
#   2) Dashboard → API Key
#   3) One key gives us a meta view across Amazon, Walmart, eBay, Target,
#      Best Buy, Coupang, Naver and many more in a single call.
# SERPAPI_KEY=

# Google Cloud Vision — https://cloud.google.com/vision
#   1) Create a project, enable the Vision API
#   2) APIs & Services -> Credentials -> Create credentials -> API key
#   3) Restrict the key to "Cloud Vision API"
#   Free tier: 1,000 image requests/month
# GOOGLE_VISION_API_KEY=


# -----------------------------------------------------------------------------
# Partner / affiliate keys (Phase 8 — currently mocked).
# -----------------------------------------------------------------------------

# Amazon Product Advertising API 5.0 — https://webservices.amazon.com/paapi5
#   1) Join Amazon Associates (https://affiliate-program.amazon.com) for your
#      target marketplace (us, jp, kr-via-jp, etc.).
#   2) Make 3 qualifying sales within 180 days to unlock PA-API access.
#   3) AWS-style access key + secret are issued in the Associates console.
#   4) Partner tag (associate tag) is the program tag like "tonyshop-20".
#   5) Optional overrides:
#       AMAZON_HOST=webservices.amazon.com  (or .co.jp, .co.uk, etc.)
#       AMAZON_REGION=us-east-1             (us-west-2 for .com, eu-west-1 for .co.uk)
#       AMAZON_MARKETPLACE=www.amazon.com
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# AMAZON_HOST=
# AMAZON_REGION=
# AMAZON_MARKETPLACE=

# Coupang Partners — https://partners.coupang.com/
#   1) Sign up as a 쿠팡파트너스 affiliate.
#   2) After approval, navigate to "마이 페이지 > 개발자 도구 > Open API"
#   3) Create access key + secret (CEA HMAC-SHA256 auth)
# COUPANG_ACCESS_KEY=
# COUPANG_SECRET_KEY=

# Shopee Affiliate / Open Platform — https://open.shopee.com/
# SHOPEE_APP_KEY=
# SHOPEE_APP_SECRET=

# Lazada Open Platform — https://open.lazada.com/
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=


# -----------------------------------------------------------------------------
# Phase 5 (Auth, DB) — placeholders.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Analytics opt-in (default enabled on Vercel deployments)
# NEXT_PUBLIC_VERCEL_ANALYTICS=1
